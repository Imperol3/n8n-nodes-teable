{
  "name": "n8n-nodes-teable-io",
  "version": "0.3.7",
  "description": "n8n community node for Teable.io — full CRUD, dynamic dropdowns, bulk operations, and upsert for your Teable tables and CRM.",
  "keywords": [
    "n8n-community-node-package",
    "teable",
    "teable.ai",
    "database",
    "crm",
    "airtable-alternative",
    "no-code",
    "postgres"
  ],
  "license": "MIT",
  "homepage": "https://github.com/imperol3/n8n-nodes-teable#readme",
  "author": {
    "name": "Kimotho",
    "email": "phoenixconsultants46@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imperol3/n8n-nodes-teable.git"
  },
  "bugs": {
    "url": "https://github.com/imperol3/n8n-nodes-teable/issues"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:icons",
    "copy:icons": "copyfiles -u 0 \"nodes/**/*.{png,svg}\" dist/",
    "dev": "tsc -p tsconfig.json -w",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "index.js",
    "LICENSE",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TeableApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Teable/Teable.node.js",
      "dist/nodes/Teable/TeableTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^5.29.0",
    "copyfiles": "^2.4.1",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^2.7.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.10",
    "n8n": ">=1.22.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
